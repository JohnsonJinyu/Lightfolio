<Page
    x:Class="Lightfolio.WinUI.Views.ShellPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Lightfolio.WinUI.ViewModels"
    mc:Ignorable="d"
    IsTabStop="True">

    <Page.Resources>
        <LinearGradientBrush x:Key="ShellWindowBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF050B13" Offset="0" />
            <GradientStop Color="#FF0A1521" Offset="0.42" />
            <GradientStop Color="#FF0D1A29" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ShellPanelBrush" Color="#CC132131" />
        <SolidColorBrush x:Key="ShellPanelAltBrush" Color="#CC16283A" />
        <SolidColorBrush x:Key="ShellPanelMutedBrush" Color="#99203346" />
        <SolidColorBrush x:Key="ShellStrokeBrush" Color="#33F3F7FC" />
        <SolidColorBrush x:Key="ShellTextBrush" Color="#FFF3F7FC" />
        <SolidColorBrush x:Key="ShellSubtleTextBrush" Color="#CCB6C4D5" />
        <SolidColorBrush x:Key="ShellFaintTextBrush" Color="#9995A7BC" />
        <SolidColorBrush x:Key="ShellDividerBrush" Color="#24F3F7FC" />

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ShellPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="{StaticResource ShellPanelMutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource ShellTextBrush}" />
        </Style>

        <Style x:Key="EdgeButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="FilterButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource ShellFaintTextBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style x:Key="PrimaryValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource ShellTextBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource ShellWindowBrush}">
        <Grid Padding="12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.ColumnSpan="3" Padding="14,10" Style="{StaticResource PanelBorderStyle}" Background="{StaticResource ShellPanelAltBrush}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Lightfolio" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource ShellTextBrush}" VerticalAlignment="Center" />

                    <TextBox Grid.Column="2" Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="搜索标题、路径、标签、设备" VerticalAlignment="Center" />

                    <Button Grid.Column="3" Style="{StaticResource ChromeButtonStyle}" Content="导入照片" Command="{x:Bind ViewModel.ImportFilesCommand}" />
                    <Button Grid.Column="4" Style="{StaticResource ChromeButtonStyle}" Content="导入文件夹" Command="{x:Bind ViewModel.ImportFolderCommand}" />

                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Style="{StaticResource ChromeButtonStyle}" Content="重置筛选" Command="{x:Bind ViewModel.ClearFiltersCommand}" />
                        <Button Style="{StaticResource ChromeButtonStyle}" Content="重新加载" Command="{x:Bind ViewModel.ReloadCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="SidebarHost" Grid.Row="1" Grid.Column="0" Width="256" Style="{StaticResource PanelBorderStyle}" Padding="0">
                <Grid>
                    <Grid Visibility="{x:Bind ViewModel.SidebarExpandedVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="12,10,12,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock Text="资料库" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource ShellTextBrush}" />
                                <TextBlock Text="目录与筛选" Foreground="{StaticResource ShellSubtleTextBrush}" />
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource EdgeButtonStyle}" Content="{x:Bind ViewModel.SidebarToggleGlyph, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleSidebarCommand}" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" Padding="12,0,12,12" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="0">
                                <StackPanel Spacing="6" Margin="0,0,0,10">
                                    <TextBlock Text="当前状态" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.LibraryStatus, Mode=OneWay}" Foreground="{StaticResource ShellTextBrush}" TextWrapping="WrapWholeWords" MaxLines="2" />
                                    <TextBlock Text="{x:Bind ViewModel.SnapshotPath, Mode=OneWay}" Foreground="{StaticResource ShellFaintTextBrush}" TextWrapping="WrapWholeWords" MaxLines="2" />
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource ShellDividerBrush}" Margin="0,0,0,10" />

                                <Grid ColumnSpacing="16" RowSpacing="10" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <TextBlock Text="资源总数" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.AssetCountText, Mode=OneWay}" Style="{StaticResource PrimaryValueStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <TextBlock Text="当前可见" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.VisibleAssetCountText, Mode=OneWay}" Style="{StaticResource PrimaryValueStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <TextBlock Text="收藏数量" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.FavoriteCountText, Mode=OneWay}" Style="{StaticResource PrimaryValueStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <TextBlock Text="精选数量" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.FeaturedCountText, Mode=OneWay}" Style="{StaticResource PrimaryValueStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="2">
                                        <TextBlock Text="时间分组" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.VisibleMonthGroupCountText, Mode=OneWay}" Style="{StaticResource PrimaryValueStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{StaticResource ShellDividerBrush}" Margin="0,0,0,10" />

                                <StackPanel Spacing="8">
                                    <TextBlock Text="筛选工具" Style="{StaticResource SectionTitleStyle}" />
                                    <ComboBox Header="媒体类型" ItemsSource="{x:Bind ViewModel.MediaFilterOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedMediaFilter, Mode=TwoWay}" />
                                    <ComboBox Header="拍摄设备" ItemsSource="{x:Bind ViewModel.CameraFilterOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedCameraFilter, Mode=TwoWay}" />
                                    <ComboBox Header="镜头" ItemsSource="{x:Bind ViewModel.LensFilterOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedLensFilter, Mode=TwoWay}" />
                                    <Button Style="{StaticResource FilterButtonStyle}" Content="{x:Bind ViewModel.FavoriteFilterButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleFavoriteFilterCommand}" />
                                    <Button Style="{StaticResource FilterButtonStyle}" Content="{x:Bind ViewModel.FeaturedFilterButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleFeaturedFilterCommand}" />
                                    <Button Style="{StaticResource FilterButtonStyle}" Content="导入照片" Command="{x:Bind ViewModel.ImportFilesCommand}" />
                                    <Button Style="{StaticResource FilterButtonStyle}" Content="导入文件夹" Command="{x:Bind ViewModel.ImportFolderCommand}" />
                                    <Button Style="{StaticResource FilterButtonStyle}" Content="清空全部筛选" Command="{x:Bind ViewModel.ClearFiltersCommand}" />
                                    <TextBlock Text="{x:Bind ViewModel.ActiveFilterSummary, Mode=OneWay}" Foreground="{StaticResource ShellSubtleTextBrush}" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <StackPanel Visibility="{x:Bind ViewModel.SidebarCollapsedVisibility, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Stretch" Spacing="10" Padding="8,10">
                        <Button Style="{StaticResource EdgeButtonStyle}" Content="{x:Bind ViewModel.SidebarToggleGlyph, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleSidebarCommand}" />
                        <TextBlock Text="库" Foreground="{StaticResource ShellFaintTextBrush}" />
                        <Border Style="{StaticResource PanelBorderStyle}" Background="{StaticResource ShellPanelMutedBrush}" Padding="6">
                            <TextBlock Text="{x:Bind ViewModel.VisibleAssetCountText, Mode=OneWay}" Foreground="{StaticResource ShellTextBrush}" HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <Border
                        Width="10"
                        HorizontalAlignment="Right"
                        Background="#22FFFFFF"
                        Opacity="0.35"
                        PointerPressed="OnSidebarResizePressed"
                        PointerMoved="OnSidebarResizeMoved"
                        PointerReleased="OnSidebarResizeReleased"
                        PointerCanceled="OnSidebarResizeCanceled" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.Column="1">
                <Border Style="{StaticResource PanelBorderStyle}" Padding="0" Visibility="{x:Bind ViewModel.BrowserVisibility, Mode=OneWay}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="14,12,14,10" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Text="时间轴" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource ShellTextBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ActiveFilterSummary, Mode=OneWay}" Foreground="{StaticResource ShellSubtleTextBrush}" />
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource ChromeButtonStyle}" Content="进入查看器" Command="{x:Bind ViewModel.EnterViewerModeCommand}" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" Padding="14,0,14,14" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.TimelineGroups, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:TimelineGroupViewModel">
                                        <StackPanel Margin="0,0,0,16" Spacing="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Label}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource ShellTextBrush}" />
                                                <TextBlock Text="{x:Bind CoverTitle}" Foreground="{StaticResource ShellSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <GridView ItemsSource="{x:Bind Assets}" IsItemClickEnabled="True" ItemClick="OnTimelineAssetClick" SelectionMode="Single" SelectedItem="{Binding ElementName=RootPage, Path=ViewModel.SelectedAsset, Mode=TwoWay}">
                                                <GridView.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:AssetItemViewModel">
                                                        <Border Width="204" Height="160" Padding="8" Margin="0,0,8,8" Style="{StaticResource PanelBorderStyle}" Background="{StaticResource ShellPanelMutedBrush}">
                                                            <Grid RowSpacing="8">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="96" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <Grid>
                                                                    <Border CornerRadius="14" Background="{StaticResource ShellPanelAltBrush}" Visibility="{x:Bind ThumbnailFallbackVisibility, Mode=OneWay}">
                                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                                                            <TextBlock Text="{x:Bind KindLabel}" Foreground="{StaticResource ShellTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                                            <TextBlock Text="{x:Bind DateLabel}" Foreground="{StaticResource ShellSubtleTextBrush}" />
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <Border CornerRadius="14" Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}">
                                                                        <Image Source="{x:Bind ThumbnailSource, Mode=OneWay}" Stretch="UniformToFill" />
                                                                    </Border>
                                                                </Grid>

                                                                <StackPanel Grid.Row="1" Spacing="3">
                                                                    <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource ShellTextBrush}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind Subtitle}" Foreground="{StaticResource ShellSubtleTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </GridView.ItemTemplate>
                                            </GridView>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Padding="0" Visibility="{x:Bind ViewModel.ViewerVisibility, Mode=OneWay}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="14,12,14,10" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource ChromeButtonStyle}" Content="返回时间轴" Command="{x:Bind ViewModel.ExitViewerModeCommand}" />

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource ShellTextBrush}" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedPositionText, Mode=OneWay}" Foreground="{StaticResource ShellSubtleTextBrush}" />
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource ChromeButtonStyle}" Content="上一张" Command="{x:Bind ViewModel.GoToPreviousAssetCommand}" IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}" />
                            <Button Grid.Column="3" Style="{StaticResource ChromeButtonStyle}" Content="下一张" Command="{x:Bind ViewModel.GoToNextAssetCommand}" IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}" />
                            <Button Grid.Column="4" Style="{StaticResource ChromeButtonStyle}" Content="适配" Click="OnZoomResetClick" />
                            <Border Grid.Column="5" Padding="10,6" CornerRadius="10" Background="{StaticResource ShellPanelMutedBrush}" BorderBrush="{StaticResource ShellStrokeBrush}" BorderThickness="1">
                                <TextBlock Text="{x:Bind ViewModel.ZoomFactorText, Mode=OneWay}" Foreground="{StaticResource ShellTextBrush}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" Margin="14,0,14,14" Padding="12" Style="{StaticResource PanelBorderStyle}" Background="{StaticResource ShellPanelAltBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,0,0,8">
                                    <Button Style="{StaticResource ChromeButtonStyle}" Content="缩小" Click="OnZoomOutClick" />
                                    <Button Style="{StaticResource ChromeButtonStyle}" Content="放大" Click="OnZoomInClick" />
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <MediaPlayerElement x:Name="ViewerMediaHost" AreTransportControlsEnabled="True" AutoPlay="False" Visibility="{x:Bind ViewModel.VideoVisibility, Mode=OneWay}" />

                                    <ScrollViewer x:Name="ViewerScrollHost" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Enabled" MinZoomFactor="0.25" MaxZoomFactor="4" ViewChanged="OnViewerScrollChanged" DoubleTapped="OnViewerDoubleTapped" PointerWheelChanged="OnViewerPointerWheelChanged" PointerPressed="OnViewerPointerPressed" PointerMoved="OnViewerPointerMoved" PointerReleased="OnViewerPointerReleased" PointerCanceled="OnViewerPointerCanceled" Visibility="{x:Bind ViewModel.PreviewImageVisibility, Mode=OneWay}">
                                        <Image x:Name="ViewerImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{x:Bind ViewModel.SelectedPreviewSource, Mode=OneWay}" ImageOpened="OnViewerImageOpened" ImageFailed="OnViewerImageFailed" />
                                    </ScrollViewer>

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="520" Visibility="{x:Bind ViewModel.PreviewFallbackVisibility, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedPreviewFallbackTitle, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource ShellTextBrush}" TextAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedPreviewFallbackDescription, Mode=OneWay}" Foreground="{StaticResource ShellSubtleTextBrush}" TextAlignment="Center" TextWrapping="WrapWholeWords" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedPath, Mode=OneWay}" Foreground="{StaticResource ShellFaintTextBrush}" TextAlignment="Center" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="DetailHost" Grid.Row="1" Grid.Column="2" Width="292" Style="{StaticResource PanelBorderStyle}" Padding="0">
                <Grid>
                    <Grid Visibility="{x:Bind ViewModel.DetailExpandedVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="12,10,12,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock Text="详情" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource ShellTextBrush}" />
                                <TextBlock Text="拍摄与文件信息" Foreground="{StaticResource ShellSubtleTextBrush}" />
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource EdgeButtonStyle}" Content="{x:Bind ViewModel.DetailToggleGlyph, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleDetailPanelCommand}" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" Padding="12,0,12,12" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="0">
                                <StackPanel Spacing="6" Margin="0,0,0,10">
                                    <TextBlock Text="拍摄概览" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedCaptureInfo, Mode=OneWay}" Foreground="{StaticResource ShellTextBrush}" TextWrapping="WrapWholeWords" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedExposureInfo, Mode=OneWay}" Foreground="{StaticResource ShellSubtleTextBrush}" TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource ShellDividerBrush}" Margin="0,0,0,10" />

                                <StackPanel Spacing="6" Margin="0,0,0,10">
                                    <TextBlock Text="文件路径" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedPath, Mode=OneWay}" Foreground="{StaticResource ShellTextBrush}" TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource ShellDividerBrush}" Margin="0,0,0,10" />

                                <StackPanel Spacing="6" Margin="0,0,0,10">
                                    <TextBlock Text="技术信息" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedTechnicalInfo, Mode=OneWay}" Foreground="{StaticResource ShellTextBrush}" TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource ShellDividerBrush}" Margin="0,0,0,10" />

                                <StackPanel Spacing="6">
                                    <TextBlock Text="位置、标签与导入" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedLocationText, Mode=OneWay}" Foreground="{StaticResource ShellTextBrush}" TextWrapping="WrapWholeWords" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedTags, Mode=OneWay}" Foreground="{StaticResource ShellSubtleTextBrush}" TextWrapping="WrapWholeWords" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedImportedAtText, Mode=OneWay}" Foreground="{StaticResource ShellTextBrush}" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <StackPanel Visibility="{x:Bind ViewModel.DetailCollapsedVisibility, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Stretch" Spacing="10" Padding="8,10">
                        <Button Style="{StaticResource EdgeButtonStyle}" Content="{x:Bind ViewModel.DetailToggleGlyph, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleDetailPanelCommand}" />
                        <TextBlock Text="详" Foreground="{StaticResource ShellFaintTextBrush}" />
                        <Border Style="{StaticResource PanelBorderStyle}" Background="{StaticResource ShellPanelMutedBrush}" Padding="6">
                            <TextBlock Text="{x:Bind ViewModel.ZoomFactorText, Mode=OneWay}" Foreground="{StaticResource ShellTextBrush}" HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <Border
                        Width="10"
                        HorizontalAlignment="Left"
                        Background="#22FFFFFF"
                        Opacity="0.35"
                        PointerPressed="OnDetailResizePressed"
                        PointerMoved="OnDetailResizeMoved"
                        PointerReleased="OnDetailResizeReleased"
                        PointerCanceled="OnDetailResizeCanceled" />
                </Grid>
            </Border>

            <Border x:Name="FilmstripHost" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Height="132" Style="{StaticResource PanelBorderStyle}" Padding="0">
                <Grid>
                    <Border
                        Height="8"
                        VerticalAlignment="Top"
                        Margin="140,0,140,0"
                        Background="#22FFFFFF"
                        Opacity="0.35"
                        PointerPressed="OnFilmstripResizePressed"
                        PointerMoved="OnFilmstripResizeMoved"
                        PointerReleased="OnFilmstripResizeReleased"
                        PointerCanceled="OnFilmstripResizeCanceled" />

                    <Grid Visibility="{x:Bind ViewModel.FilmstripExpandedVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="12,8,12,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock Text="胶卷" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource ShellTextBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedPositionText, Mode=OneWay}" Foreground="{StaticResource ShellSubtleTextBrush}" />
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource EdgeButtonStyle}" Content="{x:Bind ViewModel.FilmstripToggleGlyph, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleFilmstripCommand}" />
                        </Grid>

                        <ListView x:Name="FilmstripListView" Grid.Row="1" Margin="12,0,12,10" ItemsSource="{x:Bind ViewModel.FilmstripAssets, Mode=OneWay}" SelectedItem="{Binding ElementName=RootPage, Path=ViewModel.SelectedAsset, Mode=TwoWay}" IsItemClickEnabled="True" ItemClick="OnFilmstripAssetClick" SelectionChanged="OnFilmstripSelectionChanged" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:AssetItemViewModel">
                                    <Border Width="184" Height="76" Margin="0,0,8,0" Padding="8" Style="{StaticResource PanelBorderStyle}" Background="{StaticResource ShellPanelMutedBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <Border CornerRadius="12" Background="{StaticResource ShellPanelAltBrush}" Visibility="{x:Bind ThumbnailFallbackVisibility, Mode=OneWay}">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                                                        <TextBlock Text="{x:Bind KindLabel}" Foreground="{StaticResource ShellTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind DateLabel}" Foreground="{StaticResource ShellSubtleTextBrush}" FontSize="11" TextAlignment="Center" TextWrapping="WrapWholeWords" />
                                                    </StackPanel>
                                                </Border>

                                                <Border CornerRadius="12" Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}">
                                                    <Image Source="{x:Bind ThumbnailSource, Mode=OneWay}" Stretch="UniformToFill" />
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource ShellTextBrush}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Subtitle}" Foreground="{StaticResource ShellSubtleTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid Visibility="{x:Bind ViewModel.FilmstripCollapsedVisibility, Mode=OneWay}" Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="胶卷" Foreground="{StaticResource ShellTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{x:Bind ViewModel.SelectedPositionText, Mode=OneWay}" Foreground="{StaticResource ShellSubtleTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource EdgeButtonStyle}" Content="{x:Bind ViewModel.FilmstripToggleGlyph, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleFilmstripCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>