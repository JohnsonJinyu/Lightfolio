{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@lightfolio/shared": [
        "shared/src/index.ts"
      ],
      "@lightfolio/core": [
        "core/src/index.ts"
      ],
      "@lightfolio/core/*": [
        "core/src/*"
      ],
      "@lightfolio/shared/*": [
        "shared/src/*"
      ]
    }
  }
}
